{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_schema_help": {
      "type": "object"
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "directed",
        "metadata",
        "nodes",
        "edges"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "type": {
          "const": "feature-dependencies"
        },
        "directed": {
          "const": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "mode",
            "recorded_by",
            "recorded_at",
            "scope",
            "sources"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "mode": {
              "enum": [
                "governed",
                "historical-reconstruction"
              ]
            },
            "recorded_by": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "recorded_at": {
              "type": "string",
              "format": "date"
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "sources": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^\\d{3}-[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "metadata"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "group",
                  "scope",
                  "rows",
                  "sdd",
                  "basis",
                  "unresolved",
                  "review"
                ],
                "properties": {
                  "group": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 800,
                    "pattern": "\\S",
                    "description": "Plain-English purpose and bounded scope, supported by the node basis. Not delivery or approval evidence."
                  },
                  "scope": {
                    "enum": [
                      "legacy-backed",
                      "target-only"
                    ]
                  },
                  "rows": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 7
                    }
                  },
                  "sdd": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^specs/\\d{3}-[a-z0-9][a-z0-9-]*/spec\\.md$"
                  },
                  "basis": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "unresolved": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "review": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "source",
                          "scope_sha256"
                        ],
                        "properties": {
                          "source": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "scope_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "relation",
              "metadata"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "relation": {
                "enum": [
                  "contract",
                  "completion"
                ]
              },
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "condition",
                  "assessment",
                  "basis"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^DEP-\\d{3,}$"
                  },
                  "condition": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "assessment": {
                    "enum": [
                      "confirmed",
                      "candidate"
                    ]
                  },
                  "basis": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
