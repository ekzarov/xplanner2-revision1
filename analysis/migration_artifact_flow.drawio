<!-- ARTIFACT_RESPONSIBILITIES_START -->
<diagram id="artifact-responsibilities" name="Artifact responsibilities"><mxGraphModel grid="1" page="1" pageWidth="1260" pageHeight="9450"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="responsibility-heading" parent="1" vertex="1" value="Who creates and maintains each artifact?" style="text;html=1;fontSize=24;fontStyle=1;align=left;"><mxGeometry x="40" y="20" width="1180" height="40" as="geometry"/></mxCell>
<mxCell id="responsibility-feature-dependencies" parent="1" vertex="1" value="&lt;b&gt;feature-dependencies.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The Stage 9 agent proposes source-backed bounded slices; the coordinator creates the graph.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The coordinator records Stage 9/15 changes and exact independent review bindings. Reviewers challenge scope; the human owner decides priorities and scope changes.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Stages 9-19; analysis/feature-dependencies-guide.md. Stage 19 full graph is Phase B only." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="80" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-ui-design-system" parent="1" vertex="1" value="&lt;b&gt;ui-design-system.md&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The Stage 5 agent drafts the UI foundation and records the human owner choice.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The Stage 6 prototyping agent develops used variants and extensions within that foundation; the owner approves the exact combined baseline at Stage 8. Downstream agents read it without edits.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Stages 5-9 and 13-19; analysis/prototyping/ui-design-system-guide.md." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="250" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-ui-design-tokens" parent="1" vertex="1" value="&lt;b&gt;ui-design-tokens.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The Stage 5 agent drafts the UI foundation and records the human owner choice.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The Stage 6 prototyping agent develops used variants and extensions within that foundation; the owner approves the exact combined baseline at Stage 8. Downstream agents read it without edits.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Stages 5-9 and 13-19; analysis/prototyping/ui-design-system-guide.md." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="420" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-error-prevention" parent="1" vertex="1" value="&lt;b&gt;error-prevention-checklist.md&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The initializer creates an empty checklist; the coordinator records confirmed generalized checks.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The coordinator merges duplicates and maintains the table; the owner may prune obsolete checks. Reviewers propose without editing it.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Bootstrap and Stages 1-19; analysis/error-prevention.md; learned checks are Phase B only at Stages 2 and 19." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="590" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-owner-waiver" parent="1" vertex="1" value="&lt;b&gt;waivers/GATE-SCOPE.md&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The active-stage agent prepares the exception record; the authorized human grants or refuses it.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The agent preserves the decision and tracks residual obligations; only the human authority extends the exception.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; The named waiver provision in MIGRATION.md and the active stage procedure." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="760" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-owner-walkthrough-decline" parent="1" vertex="1" value="&lt;b&gt;owner-walkthrough-decline.md&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; PM records the human owner explicit decision to decline the optional Stage 19 walkthrough.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The owner decides; PM preserves evidence and its exact status reference. QA does not write shared decisions.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Stage 19 optional owner walkthrough and final completion decision contract." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="930" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-agent-instructions" parent="1" vertex="1" value="&lt;b&gt;AGENTS.md&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; Starter maintainer (human or authorized agent); the initializer copies the file into a project.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The authorized process maintainer updates routing rules.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; MIGRATION.md" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="1100" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-migration-entry" parent="1" vertex="1" value="&lt;b&gt;MIGRATION.md&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; Starter maintainer (human or authorized agent); the initializer copies the session entry point.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The process maintainer keeps routing consistent with the constitution and methodology.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; MIGRATION.md" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="1270" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-methodology" parent="1" vertex="1" value="&lt;b&gt;migration_methodology.md&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; Starter process maintainer (human or authorized agent); the initializer supplies the project copy.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The process maintainer updates procedures and synchronizes their presentations.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; MIGRATION.md" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="1440" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-constitution" parent="1" vertex="1" value="&lt;b&gt;constitution.md&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The Bootstrap initializer renders the template; the Bootstrap agent records the human owner ratification.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The agent records explicit owner-approved amendments; the owner decides the governing rules.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Bootstrap constitution ratification" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="1610" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-status" parent="1" vertex="1" value="&lt;b&gt;migration_status.yaml&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The Bootstrap initializer creates the checkpoint from its template.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; PM records durable outcomes, blockers and authorized transitions from specialist evidence; reviewers never edit shared status.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Bootstrap and Stage 1-19 status contract; analysis/agent-roles.md" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="1780" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-project-contract" parent="1" vertex="1" value="&lt;b&gt;project.yaml&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The Bootstrap initializer renders project identity and command slots; the Bootstrap agent fills verified project values.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The responsible project agent records explicit command/configuration changes and validates the contract.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Bootstrap project contract" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="1950" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-environment-contract" parent="1" vertex="1" value="&lt;b&gt;environments.yaml&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The initializer generates an unconfigured contract from the public-safe template; an authorized agent records owner-approved environments before remote work.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The deployment agent or authorized operator maintains verified connection and deployment settings; initialization never renews credential approval.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Bootstrap and remote-operation environment contract" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="2120" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-bootstrap-gate-report" parent="1" vertex="1" value="&lt;b&gt;bootstrap-gate-report.md&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The initializer creates a pending report; the Bootstrap agent fills it from actual audit output.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The Bootstrap agent records reruns and corrections; the human owner authorizes entry to Stage 1.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Bootstrap audit and transition procedure" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="2290" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-recon-record" parent="1" vertex="1" value="&lt;b&gt;legacy_reconnaissance.md&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The initializer creates an empty record; the Stage 1 reconnaissance agent writes the findings.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The reconnaissance agent updates the inventory when discovery or an authorized return changes its scope.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Bootstrap and Stage 1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="2460" width="1180" height="150" as="geometry"/></mxCell>
<mxCell id="responsibility-parity-map" parent="1" vertex="1" value="&lt;b&gt;legacy_user_flows.xlsx&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Created by:&lt;/b&gt; The initializer creates the workbook; the Stage 1 reconnaissance agent populates evidence-backed behavior rows.&lt;br&gt;&lt;b&gt;Maintained / decided by:&lt;/b&gt; The active-stage agent updates its owned columns; the human owner decides scope changes and deferrals.&lt;br&gt;&lt;b&gt;Instructions:&lt;/b&gt; Bootstrap and Stage 1-19 workbook instructions" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="2630" width="1180" height="150" as="geometry"/></mxCell>
