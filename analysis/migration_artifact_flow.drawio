<!-- DOCUMENT_OWNERSHIP_START -->
<diagram id="document-ownership" name="Document ownership"><mxGraphModel page="1" pageWidth="1260" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="document-owner-0" parent="1" vertex="1" value="&lt;b&gt;Constitution: Which rules must every agent and stage obey, and which decisions belong only to the owner?&lt;/b&gt;&lt;br&gt;Project invariants, decision authority, ratification and controlled amendments.&lt;br&gt;Not: Stage numbers, packet phase names, reading lists, worksheet layout, command recipes or a second stage procedure." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;"><mxGeometry x="40" y="40" width="1180" height="150" as="geometry"/></mxCell><mxCell id="document-owner-1" parent="1" vertex="1" value="&lt;b&gt;MIGRATION.md: What may I do in this session, and what must I read next?&lt;/b&gt;&lt;br&gt;Mandatory reading order, session routing, detailed Bootstrap and maintenance procedure, restrictions and stops.&lt;br&gt;Not: Project state or the full execution procedure for Stages 1-19." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;"><mxGeometry x="40" y="220" width="1180" height="150" as="geometry"/></mxCell><mxCell id="document-owner-2" parent="1" vertex="1" value="&lt;b&gt;Process contract: Which roles, boundaries and closing conditions must every view preserve?&lt;/b&gt;&lt;br&gt;Shared stage responsibilities, artifact access, returns and minimum closing evidence.&lt;br&gt;Not: Detailed execution, project decisions or permission to weaken the constitution." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;"><mxGeometry x="40" y="400" width="1180" height="150" as="geometry"/></mxCell><mxCell id="document-owner-3" parent="1" vertex="1" value="&lt;b&gt;Methodology: How do I execute the selected stage and prove that it is complete?&lt;/b&gt;&lt;br&gt;Stage 1-19 procedures: inputs, actions, outputs, checks and application of shared transition rules; links to the governing Bootstrap procedure.&lt;br&gt;Not: Selecting the current stage, duplicating Bootstrap execution or overriding owner authority." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;"><mxGeometry x="40" y="580" width="1180" height="150" as="geometry"/></mxCell><mxCell id="document-owner-4" parent="1" vertex="1" value="&lt;b&gt;Portable role contract and skills: Who executes the stage, which skill do they read, and how is work handed back?&lt;/b&gt;&lt;br&gt;Six role assignments, explicit skill loading, delegation, ACK/results and single-writer coordination.&lt;br&gt;Not: A runtime service, independent approval by an author, or replacement stage procedures." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;"><mxGeometry x="40" y="760" width="1180" height="150" as="geometry"/></mxCell><mxCell id="document-owner-5" parent="1" vertex="1" value="&lt;b&gt;Domain instructions and templates: How do I prepare and check this particular artifact?&lt;/b&gt;&lt;br&gt;Exact file structure, workbook fields and artifact-specific operations delegated by the methodology.&lt;br&gt;Not: Independent authority to change stage scope, approve decisions or bypass gates." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;"><mxGeometry x="40" y="940" width="1180" height="150" as="geometry"/></mxCell><mxCell id="document-owner-6" parent="1" vertex="1" value="&lt;b&gt;migration_status.yaml: Where are we, what is blocked and what was authorized?&lt;/b&gt;&lt;br&gt;Durable project state and links to actual evidence.&lt;br&gt;Not: Instructions or approval inferred from a status label." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=16;"><mxGeometry x="40" y="1120" width="1180" height="150" as="geometry"/></mxCell><mxCell id="document-ownership-note" parent="1" vertex="1" value="Reading order is not authority order: MIGRATION.md is read first; the ratified constitution has the highest project authority. Domain guides own exact artifact formats. migration_status.yaml records state, not instructions or inferred approval. Stop affected work when documents conflict." style="text;whiteSpace=wrap;html=1;align=left;fontSize=16;"><mxGeometry x="40" y="1140" width="1180" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<!-- DOCUMENT_OWNERSHIP_END -->
</mxfile>
