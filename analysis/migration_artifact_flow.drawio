<mxCell id="stage-flow-stage-15" parent="1" vertex="1" value="&lt;b&gt;15: Design: SDD&lt;/b&gt;&lt;br&gt;Lead: Architect (responsible author); PM coordinates (agent-roles.md)&lt;br&gt;Responsibility: none&lt;br&gt;I: prototyping/ui-ux-approval.md; screen-manifest.json; architecture-nfr-manifest.json; knowledge/bundle/**; knowledge-manifest.json; ui-design-system.md; ui-design-tokens.json&lt;br&gt;U: migration_status.yaml; legacy_user_flows.xlsx; ui-polish-backlog.md; feature-dependencies.json&lt;br&gt;O: specs/NNN-*/spec.md; specs/NNN-*/plan.md; specs/NNN-*/tasks.md; specs/traceability.md; target-surface-inventory.json; stage-15/sdd-record.md; waivers/GATE-SCOPE.md&lt;br&gt;Phase B: None" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#f5f7fa;strokeColor=#cbd5df;"><mxGeometry x="40" y="4040" width="1120" height="240" as="geometry"/></mxCell>
<mxCell id="stage-flow-stage-16" parent="1" vertex="1" value="&lt;b&gt;16: Design re-verification&lt;/b&gt;&lt;br&gt;Lead: Architect (fresh independent reviewer); PM coordinates (agent-roles.md)&lt;br&gt;Responsibility: independent&lt;br&gt;I: specs/NNN-*/spec.md; specs/NNN-*/plan.md; specs/NNN-*/tasks.md; specs/traceability.md; target-surface-inventory.json; stage-15/sdd-record.md; ui-polish-backlog.md; ui-design-system.md; ui-design-tokens.json&lt;br&gt;U: migration_status.yaml; feature-dependencies.json&lt;br&gt;O: stage-16-pass-NNN.md&lt;br&gt;Phase B: None" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#f5f7fa;strokeColor=#2199b5;dashed=0;"><mxGeometry x="40" y="4300" width="1120" height="240" as="geometry"/></mxCell>
<mxCell id="stage-flow-stage-17" parent="1" vertex="1" value="&lt;b&gt;17: Build&lt;/b&gt;&lt;br&gt;Lead: Developer (responsible author); separate Developer peer; PM coordinates (agent-roles.md)&lt;br&gt;Responsibility: peer&lt;br&gt;I: stage-16-pass-NNN.md; specs/NNN-*/spec.md; specs/NNN-*/plan.md; specs/NNN-*/tasks.md; ui-design-system.md; ui-design-tokens.json; feature-dependencies.json&lt;br&gt;U: migration_status.yaml; specs/traceability.md; target-surface-inventory.json; ui-polish-backlog.md&lt;br&gt;O: source code; tests and measurements; data migrations; PR + pinned revision&lt;br&gt;Phase B: None" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#f5f7fa;strokeColor=#2199b5;dashed=0;"><mxGeometry x="40" y="4560" width="1120" height="240" as="geometry"/></mxCell>
<mxCell id="stage-flow-stage-18" parent="1" vertex="1" value="&lt;b&gt;18: Delivery and live reconciliation&lt;/b&gt;&lt;br&gt;Lead: Developer (responsible-agent verification); PM coordinates (agent-roles.md)&lt;br&gt;Responsibility: primary&lt;br&gt;I: PR + pinned revision; environments.yaml; target-surface-inventory.json; prototyping/ui-ux-approval.md; screen-manifest.json; specs/NNN-*/spec.md; ui-polish-backlog.md; ui-design-system.md; ui-design-tokens.json; feature-dependencies.json&lt;br&gt;U: migration_status.yaml; specs/traceability.md; legacy_user_flows.xlsx&lt;br&gt;O: stage-18/delivery-NNN.md; raw journey + summary&lt;br&gt;Phase B: None" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#f5f7fa;strokeColor=#2199b5;dashed=1;"><mxGeometry x="40" y="4820" width="1120" height="240" as="geometry"/></mxCell>
