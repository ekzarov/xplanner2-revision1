{
  "name": "legacy-modernization-audit-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic, stack-agnostic audit gates for the legacy modernization workflow",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "audit:status": "node status-validator.js",
    "audit:acceptance": "node status-validator.js --require-completion",
    "audit:project": "node project-config-audit.js",
    "audit:environment": "node environment-config-audit.js",
    "audit:delivery": "node delivery-record-audit.js --verify-connection --verify-user-journey --verify-visual-parity",
    "audit:workbook": "node workbook-audit.js",
    "sync:workbook-progress": "node workbook-progress.js --write",
    "audit:workbook-progress": "node workbook-progress.js",
    "audit:workbook:excel": "pwsh -NoProfile -File excel-open-audit.ps1",
    "audit:prototype": "node prototype-audit.js",
    "audit:prototype:approved": "node prototype-audit.js --require-approval",
    "audit:architecture": "node architecture-audit.js",
    "audit:architecture:foundation": "node architecture-audit.js --foundation",
    "audit:architecture:approved": "node architecture-audit.js --require-verdict",
    "audit:architecture:closure": "node architecture-audit.js --require-closure",
    "audit:architecture:history": "node architecture-review-history.js",
    "audit:knowledge": "node knowledge-audit.js",
    "audit:sdd": "node sdd-audit.js",
    "audit:sdd:complete": "node sdd-audit.js --require-completion",
    "audit:ui-parity": "node ui-parity-audit.js",
    "audit:ui-parity:deployed": "node ui-parity-audit.js --deployed",
    "audit:target": "node target-surface-audit.js",
    "audit:artifact-links": "node artifact-reference-links.js --check",
    "fix:artifact-links": "node artifact-reference-links.js --write",
    "audit:methodology": "node methodology-link-audit.js",
    "audit:views": "node process-view-audit.js",
    "audit:roles": "node agent-role-contract.js",
    "audit:agent-system": "node ../agent-system/build-view.js --check",
    "audit:readability": "node artifact-reading.js",
    "format:artifact-templates": "node artifact-reading.js --write-templates",
    "audit:stage-gates": "node sync-stage-gates.js",
    "sync:stage-gates": "node sync-stage-gates.js --write",
    "audit:stage19": "npm run audit:status && npm run audit:project && npm run audit:environment && npm run audit:workbook && npm run audit:prototype:approved && npm run audit:architecture:approved && npm run audit:knowledge && npm run audit:sdd:slice && npm run audit:ui-parity && npm run audit:target && npm run audit:delivery && npm run audit:artifact-links && npm run audit:methodology && npm run audit:views && npm run audit:prevention && npm run audit:dependencies",
    "audit:responsibilities": "node artifact-responsibility-audit.js",
    "remote:check": "node remote-connect.js --check",
    "remote:shell": "node remote-connect.js",
    "audit:all": "npm run audit:stage19 && npm run audit:sdd:complete && npm run audit:acceptance",
    "test": "node --test",
    "audit:sdd:slice": "node sdd-audit.js --require-slice-completion",
    "audit:process-contract": "node process-contract.js && node process-consistency-audit.js",
    "audit:translations": "node translation-audit.js",
    "audit:prevention": "node error-prevention-audit.js",
    "audit:dependencies": "node feature-dependencies.js",
    "audit:dependency-view": "node ../feature-canvas/build-data.js --check"
  },
  "dependencies": {
    "@dagrejs/graphlib": "4.0.5",
    "@excel.js/exceljs": "0.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.1.2",
    "elkjs": "0.12.0",
    "lucide": "1.46.0",
    "markdown-it": "^14.1.0",
    "yaml": "^2.8.1"
  }
}
